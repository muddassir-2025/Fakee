# ---------------------------------------------------------------------------
# Fakee — backend configuration
# Copy to `.env` and fill in the keys you have. Every service is optional:
# without keys the app runs in a fully-functional demo mode.
# ---------------------------------------------------------------------------

# This file is read from either the repo root (`.env`) or `backend/.env`.
# Set ENVIRONMENT=production to disable interactive docs, hide internal error
# details, add HSTS, and enable stricter defaults.
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Allowed Host headers (comma-separated, "*" to disable the check).
TRUSTED_HOSTS=*
# Trust X-Forwarded-For/-Proto. Enable only behind a known proxy/load balancer.
TRUST_PROXY=false
# Reject request bodies larger than this (bytes).
MAX_REQUEST_BYTES=1000000
# Include internal error messages in 500 responses (auto-off in production).
EXPOSE_ERROR_DETAILS=true

# --- Database ---------------------------------------------------------------
# Local default (SQLite) needs no setup:
DATABASE_URL=sqlite+aiosqlite:///./data/investigations.db
# Neon PostgreSQL (production). A plain `postgresql://` URL copied straight from
# the Neon dashboard also works — it is auto-rewritten to asyncpg and TLS:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/DBNAME

# --- Groq (LLM extraction + evidence structuring) ---------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Captured page text sent per evidence call. Default fits Groq's free tier
# (gpt-oss-120b: 8K tokens/minute); raise it on a paid tier.
GROQ_EVIDENCE_MAX_CHARS=8000

# --- Exa (OPTIONAL server-side search — OFF by default) ----------------------
# Not required. The Chrome extension runs the searches and page reads in the
# user's own browser, so the product works end-to-end with no search API.
# Turn this on only if you want the server-side POST /api/investigate path to
# do live search; without it that endpoint uses deterministic mock results.
EXA_ENABLED=false
# Only used when EXA_ENABLED=true. Get a key at https://dashboard.exa.ai.
EXA_API_KEY=
# auto | fast | instant | deep-lite | deep | deep-reasoning (auto is the default)
EXA_SEARCH_TYPE=auto

# Create tables from the models at startup (dev/tests convenience). Set false
# in production and manage the schema with Alembic (`alembic upgrade head`,
# which the container entrypoint runs automatically).
AUTO_CREATE_SCHEMA=true

# --- Database pool (PostgreSQL only; SQLite ignores it) ----------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# --- Resilience -------------------------------------------------------------
GROQ_MAX_RETRIES=3
GROQ_BACKOFF_BASE_SECONDS=1.5
EXA_MAX_RETRIES=3
EXA_BACKOFF_BASE_SECONDS=1.0
EXA_MAX_CONCURRENCY=5
INVESTIGATION_TIMEOUT_SECONDS=240

# --- Rate limiting (per client IP) ------------------------------------------
RATE_LIMIT_INVESTIGATIONS=20
RATE_LIMIT_REPORTS=60
RATE_LIMIT_WINDOW_SECONDS=300
RATE_LIMIT_MAX_KEYS=10000

# --- Cost controls ----------------------------------------------------------
# Serve a repeated company/domain check from a cached, company-level result
# instead of re-running search + Groq. Stores no user text.
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_SECONDS=86400
# Skip the Groq evidence call when no captured page is about the company (only
# generic scam-advice pages came back) and report an inconclusive result rather
# than paying for an empty structuring.
SKIP_GROQ_WHEN_EVIDENCE_IRRELEVANT=true
# Skip the Groq extraction call when the deterministic extractor already found
# a subject and a concrete signal; ask Groq only for messy/ambiguous text.
PREFER_HEURISTIC_EXTRACTION=true

# --- Investigation tuning ---------------------------------------------------
# Curated budget; the extension runs at most this many searches per request.
MAX_SEARCH_QUERIES=12
MAX_SCRAPE_PAGES=12
SEARCH_RESULTS_PER_QUERY=6
DOMAIN_RECENT_DAYS=180
