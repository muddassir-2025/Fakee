# ---------------------------------------------------------------------------
# Fakee — website configuration
# Copy to `frontend/.env` (or `.env.local`). All of these are build-time values:
# Vite inlines them, so rebuild after changing one.
# ---------------------------------------------------------------------------

# --- Neon Auth (Managed Better Auth) ----------------------------------------
# The Auth Base URL from the Neon console (Better Auth -> Configuration), e.g.
#   https://ep-xxx.neonauth.us-east-2.aws.neon.build/neondb/auth
# It must be the same value as the backend's NEON_AUTH_BASE_URL. Leave empty to
# ship the site without sign-in: investigating still works, but the API refuses
# to file a report (there would be nobody to attribute it to).
VITE_NEON_AUTH_URL=

# --- API --------------------------------------------------------------------
# Where the report/profile/admin API lives. Empty means "same origin", which is
# what the dev server wants (Vite proxies /api to 127.0.0.1:8000). In a
# deployment set the backend origin, e.g. https://fakee-api.onrender.com, and add
# that site's origin to the backend's CORS_ORIGINS.
VITE_API_BASE=

# --- Optional ---------------------------------------------------------------
# Chrome Web Store listing URL; the extension id is read from it so the site can
# detect the extension and run a check inline.
VITE_EXTENSION_STORE_URL=
# The address allowed into the admin dashboard. Cosmetic only — the API enforces
# its own ADMIN_EMAILS allowlist and returns 403 regardless of what is rendered.
VITE_ADMIN_EMAIL=studymuddassir@gmail.com
